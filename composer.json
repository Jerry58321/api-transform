{
    "name": "jerry58321/api-transform",
    "description": "A Laravel API response transformation layer for reusable model and feature transforms.",
    "keywords": ["laravel", "api", "transform", "transformer", "response"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "jerry58321\\ApiTransform\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "require": {
        "php" : "^8.1",
        "symfony/http-foundation": "^5.0|^6.0|^7.0",
        "illuminate/console": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/pagination": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.3|^10.0|^11.0|^12.0",
        "symfony/var-dumper": "^6.0|^7.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
                "jerry58321\\ApiTransform\\TransformServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
